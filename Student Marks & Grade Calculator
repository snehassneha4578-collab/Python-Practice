# Student Marks and Grade Calculator

print("======================================")
print("       STUDENT RESULT CALCULATOR")
print("======================================")

name = input("Enter student name: ")

m1 = float(input("Enter marks in Python: "))
m2 = float(input("Enter marks in Java: "))
m3 = float(input("Enter marks in DBMS: "))
m4 = float(input("Enter marks in Mathematics: "))
m5 = float(input("Enter marks in Computer Networks: "))

total = m1 + m2 + m3 + m4 + m5
percentage = total / 5

if percentage >= 90:
    grade = "A+"
elif percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 50:
    grade = "D"
else:
    grade = "F"

print("\n======================================")
print("           STUDENT RESULT")
print("======================================")
print("Name       :", name)
print("Python     :", m1)
print("Java       :", m2)
print("DBMS       :", m3)
print("Mathematics:", m4)
print("Networks   :", m5)
print("--------------------------------------")
print("Total Marks:", total, "/ 500")
print("Percentage :", percentage, "%")
print("Grade      :", grade)
print("======================================")
