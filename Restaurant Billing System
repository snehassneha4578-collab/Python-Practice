print("========================================")
print("          RESTAURANT BILLING SYSTEM")
print("========================================")

items = []

while True:
    print("\n========================================")
    print("              RESTAURANT MENU")
    print("========================================")
    print("1. Add Item")
    print("2. View Bill")
    print("3. Remove Item")
    print("4. Generate Final Bill")
    print("5. Exit")
    print("========================================")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        item_name = input("Enter item name: ")
        price = float(input("Enter item price: "))
        quantity = int(input("Enter quantity: "))

        total = price * quantity

        item = {
            "name": item_name,
            "price": price,
            "quantity": quantity,
            "total": total
        }

        items.append(item)

        print("Item added successfully.")

    elif choice == 2:
        print("\n========== CURRENT BILL ==========")

        if len(items) == 0:
            print("No items added.")
        else:
            grand_total = 0

            for i, item in enumerate(items, start=1):
                print("\nItem", i)
                print("Name     :", item["name"])
                print("Price    :", item["price"])
                print("Quantity :", item["quantity"])
                print("Total    :", item["total"])

                grand_total += item["total"]

            print("\nSubtotal :", grand_total)

    elif choice == 3:
        item_name = input("Enter item name to remove: ")
        found = False

        for item in items:
            if item["name"].lower() == item_name.lower():
                items.remove(item)
                print("Item removed successfully.")
                found = True
                break

        if not found:
            print("Item not found.")

    elif choice == 4:
        print("\n========================================")
        print("           FINAL RESTAURANT BILL")
        print("========================================")

        if len(items) == 0:
            print("No items added.")
        else:
            subtotal = 0

            for i, item in enumerate(items, start=1):
                print(
                    i,
                    ".",
                    item["name"],
                    "x",
                    item["quantity"],
                    "=",
                    item["total"]
                )

                subtotal += item["total"]

            gst = subtotal * 0.05
            final_amount = subtotal + gst

            print("----------------------------------------")
            print("Subtotal :", subtotal)
            print("GST (5%) :", gst)
            print("Total    :", final_amount)
            print("----------------------------------------")
            print("Thank you! Visit again.")
            print("========================================")

    elif choice == 5:
        print("\nThank you for using the Restaurant Billing System.")
        break

    else:
        print("Invalid choice. Please try again.")
