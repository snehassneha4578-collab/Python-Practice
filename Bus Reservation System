print("========================================")
print("          BUS RESERVATION SYSTEM")
print("========================================")

seats = {}

for i in range(1, 21):
    seats[i] = None

while True:
    print("\n========================================")
    print("              BUS MENU")
    print("========================================")
    print("1. View Available Seats")
    print("2. Book Seat")
    print("3. Cancel Booking")
    print("4. View Passenger Details")
    print("5. Exit")
    print("========================================")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        print("\n========== SEAT STATUS ==========")

        for seat, passenger in seats.items():
            if passenger is None:
                print("Seat", seat, ": Available")
            else:
                print("Seat", seat, ": Booked")

    elif choice == 2:
        seat_no = int(input("Enter seat number (1-20): "))

        if seat_no in seats:

            if seats[seat_no] is None:
                name = input("Enter passenger name: ")
                age = int(input("Enter passenger age: "))
                phone = input("Enter phone number: ")

                seats[seat_no] = {
                    "name": name,
                    "age": age,
                    "phone": phone
                }

                print("\nSeat booked successfully!")
                print("Seat Number:", seat_no)
                print("Passenger   :", name)

            else:
                print("Seat is already booked.")

        else:
            print("Invalid seat number.")

    elif choice == 3:
        seat_no = int(input("Enter seat number to cancel: "))

        if seat_no in seats:

            if seats[seat_no] is not None:
                seats[seat_no] = None
                print("Booking cancelled successfully.")
            else:
                print("This seat is not booked.")

        else:
            print("Invalid seat number.")

    elif choice == 4:
        seat_no = int(input("Enter seat number: "))

        if seat_no in seats:

            if seats[seat_no] is not None:
                passenger = seats[seat_no]

                print("\n========== PASSENGER DETAILS ==========")
                print("Seat Number :", seat_no)
                print("Name        :", passenger["name"])
                print("Age         :", passenger["age"])
                print("Phone       :", passenger["phone"])

            else:
                print("No passenger is assigned to this seat.")

        else:
            print("Invalid seat number.")

    elif choice == 5:
        print("\nThank you for using the Bus Reservation System.")
        print("Have a safe journey!")
        break

    else:
        print("Invalid choice. Please try again.")
