print("========================================")
print("          HOTEL BOOKING SYSTEM")
print("========================================")

rooms = {
    101: {"type": "Single", "price": 1500, "status": "Available"},
    102: {"type": "Single", "price": 1500, "status": "Available"},
    201: {"type": "Double", "price": 2500, "status": "Available"},
    202: {"type": "Double", "price": 2500, "status": "Available"},
    301: {"type": "Deluxe", "price": 4000, "status": "Available"}
}

while True:
    print("\n========================================")
    print("              HOTEL MENU")
    print("========================================")
    print("1. View Rooms")
    print("2. Book Room")
    print("3. Cancel Booking")
    print("4. Search Room")
    print("5. View Booking Details")
    print("6. Exit")
    print("========================================")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        print("\n========== ROOM DETAILS ==========")

        for room_no, room in rooms.items():
            print("\nRoom Number :", room_no)
            print("Room Type   :", room["type"])
            print("Price       :", room["price"])
            print("Status      :", room["status"])

    elif choice == 2:
        room_no = int(input("Enter room number to book: "))

        if room_no in rooms:
            if rooms[room_no]["status"] == "Available":

                name = input("Enter customer name: ")
                phone = input("Enter phone number: ")

                rooms[room_no]["status"] = "Booked"
                rooms[room_no]["customer"] = name
                rooms[room_no]["phone"] = phone

                print("\nRoom booked successfully!")
                print("Customer Name :", name)
                print("Room Number   :", room_no)

            else:
                print("Room is already booked.")
        else:
            print("Room does not exist.")

    elif choice == 3:
        room_no = int(input("Enter room number to cancel: "))

        if room_no in rooms:
            if rooms[room_no]["status"] == "Booked":

                rooms[room_no]["status"] = "Available"
                del rooms[room_no]["customer"]
                del rooms[room_no]["phone"]

                print("Booking cancelled successfully.")

            else:
                print("Room is not currently booked.")
        else:
            print("Room does not exist.")

    elif choice == 4:
        room_no = int(input("Enter room number to search: "))

        if room_no in rooms:
            room = rooms[room_no]

            print("\n========== ROOM INFORMATION ==========")
            print("Room Number :", room_no)
            print("Room Type   :", room["type"])
            print("Price       :", room["price"])
            print("Status      :", room["status"])
        else:
            print("Room does not exist.")

    elif choice == 5:
        room_no = int(input("Enter room number: "))

        if room_no in rooms:
            room = rooms[room_no]

            if room["status"] == "Booked":
                print("\n========== BOOKING DETAILS ==========")
                print("Room Number   :", room_no)
                print("Room Type     :", room["type"])
                print("Customer Name :", room["customer"])
                print("Phone Number  :", room["phone"])
                print("Room Price    :", room["price"])
            else:
                print("No booking exists for this room.")

        else:
            print("Room does not exist.")

    elif choice == 6:
        print("\nThank you for using the Hotel Booking System.")
        break

    else:
        print("Invalid choice. Please try again.")
